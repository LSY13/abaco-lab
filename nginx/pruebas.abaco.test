# /etc/nginx/sites-available/pruebas.abaco.test
# Desde el 15 oct todo el sitio lo sirve el contenedor del proyecto abaco-pruebas (127.0.0.1:3002).
server {
    listen 80;
    listen [::]:80;
    server_name pruebas.abaco.test;

    access_log /var/log/nginx/pruebas.access.log;
    error_log  /var/log/nginx/pruebas.error.log;

    # Proxy inverso al contenedor PRUEBAS (publicado solo en 127.0.0.1 de la VM)
    location / {
        proxy_pass http://127.0.0.1:3002/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
